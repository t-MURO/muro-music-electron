{
  "name": "muro-music-electron",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-or-later",
  "description": "A customizable desktop music library and player",
  "author": "Muro Music contributors",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "main": "electron/main.mjs",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "keyfinder:build": "node scripts/build-keyfinder.cjs --release",
    "keyfinder:build:release": "node scripts/build-keyfinder.cjs --release",
    "keyfinder:download": "node scripts/download-keyfinder-release.cjs",
    "fpcalc:prepare": "node scripts/prepare-fpcalc.cjs",
    "predev:electron": "npm run fpcalc:prepare && npm run keyfinder:build",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/dev-electron.cjs",
    "icons:build": "node scripts/generate-app-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:node": "node scripts/check-node-syntax.mjs",
    "check": "npm run typecheck && npm run check:node",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node tests/run-smoke.cjs",
    "test:acoustid": "node tests/run-acoustid-smoke.cjs",
    "test:protocol": "node tests/file-protocol-smoke.mjs",
    "test:security": "node tests/renderer-security-smoke.mjs",
    "test:metadata-rating": "node tests/run-metadata-rating-smoke.cjs",
    "pretest:keyfinder": "npm run keyfinder:build",
    "test:keyfinder": "node tests/keyfinder-smoke.mjs",
    "test:keyfinder-client": "node tests/keyfinder-client-smoke.mjs",
    "test:audio-seek": "node tests/run-audio-seek-smoke.cjs",
    "test:beatgrid": "node tests/beatgrid-smoke.mjs",
    "test:mixplan": "node tests/mixplan-smoke.mjs",
    "test:set-planner": "node tests/set-planner-smoke.mjs",
    "test:playback-guard": "node tests/playback-guard-smoke.mjs",
    "test:sleep-timer": "node tests/sleep-timer-smoke.mjs",
    "test:play-tracking": "node tests/play-tracking-smoke.mjs",
    "test:playback-session": "node tests/playback-session-smoke.mjs",
    "test:scrobble": "node tests/run-scrobble-smoke.cjs",
    "test:indexed-search": "node tests/indexed-search-smoke.mjs",
    "test:artist-separators": "node tests/artist-separator-smoke.mjs",
    "test:artist-credits": "node tests/run-artist-credits-db-smoke.cjs",
    "test:search-index": "node tests/run-search-index-smoke.cjs",
    "test:loudness": "node tests/loudness-smoke.mjs",
    "test:library-verify": "node tests/run-library-verify-smoke.cjs",
    "test:library-watcher": "node tests/run-library-watcher-smoke.cjs",
    "test:library-paths": "node tests/run-library-paths-smoke.cjs",
    "test:i18n": "node tests/i18n-smoke.mjs",
    "analyze:structure": "electron scripts/analyze-library-structure.mjs",
    "test:library-export": "node tests/run-library-export-smoke.cjs",
    "test:data-features": "node tests/run-data-features-smoke.cjs",
    "test:automatic-backups": "node tests/run-automatic-backups-smoke.cjs",
    "test:update-check": "node tests/update-check-smoke.mjs",
    "test:task-center": "node tests/task-center-smoke.mjs",
    "test:cast": "node tests/cast-protocol-smoke.mjs && node tests/cast-media-server-smoke.mjs && node tests/cast-service-smoke.mjs && node tests/cast-adapter-smoke.mjs",
    "test:dlna": "node tests/dlna-smoke.mjs && node tests/dlna-service-smoke.mjs",
    "test:renderer": "node tests/run-renderer-smoke.cjs",
    "test:renderer:settings": "node tests/run-renderer-smoke.cjs --settings",
    "test:renderer-dev": "node tests/run-renderer-dev-smoke.cjs",
    "test:ci:core": "npm run test:smoke && npm run test:acoustid && npm run test:protocol && npm run test:security && npm run test:metadata-rating && npm run test:beatgrid && npm run test:mixplan && npm run test:set-planner && npm run test:playback-guard && npm run test:sleep-timer && npm run test:play-tracking && npm run test:scrobble && npm run test:playback-session && npm run test:keyfinder-client && npm run test:artist-separators && npm run test:artist-credits && npm run test:search-index && npm run test:indexed-search && npm run test:loudness && npm run test:library-verify && npm run test:library-watcher && npm run test:library-paths && npm run test:i18n && npm run test:library-export && npm run test:data-features && npm run test:automatic-backups && npm run test:cast && npm run test:dlna && npm run test:update-check && npm run test:task-center",
    "test:ci:ui": "npm run test:audio-seek && npm run test:renderer && npm run test:renderer:settings",
    "verify:release": "npm run check && npm run test:ci:core && vite build && npm run test:ci:ui",
    "build": "npm run check && vite build",
    "prestart": "npm run fpcalc:prepare",
    "start": "electron .",
    "prepackage": "npm run fpcalc:prepare && npm run keyfinder:build",
    "package": "npm run build && electron-builder --dir",
    "predist": "npm run fpcalc:prepare && npm run keyfinder:build:release",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@neo-keyfinder/engine-client": "file:packages/engine-client",
    "@tanstack/react-virtual": "^3.11.2",
    "better-sqlite3": "^12.10.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.542.0",
    "music-metadata": "^11.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "sharp": "^0.35.3",
    "taglib-wasm": "^1.4.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "42.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.muro.music.electron",
    "productName": "Muro Music",
    "beforePack": "scripts/stage-packaged-resources.cjs",
    "afterPack": "scripts/verify-packaged-resources.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/taglib-wasm/**/*"
    ],
    "extraResources": [
      {
        "from": "build/keyfinder",
        "to": "keyfinder"
      },
      {
        "from": "build/fpcalc",
        "to": "fpcalc",
        "filter": [
          "fpcalc*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icons/icon.png"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
